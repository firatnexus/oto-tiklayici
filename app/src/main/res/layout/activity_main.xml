<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold"
            android:textColor="#202124" android:layout_marginBottom="16dp"/>

        <!-- İzin kartı -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:padding="16dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/permText" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"/>
            <Button android:id="@+id/permBtn" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/perm_button"/>
        </LinearLayout>

        <!-- Mod -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/mode_title" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#202124" android:layout_marginTop="20dp"/>
        <RadioGroup android:id="@+id/modeGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/modeSingle" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/mode_single" android:textSize="16sp"/>
            <RadioButton android:id="@+id/modeMulti" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/mode_multi" android:textSize="16sp"/>
        </RadioGroup>
        <TextView android:id="@+id/modeDesc" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text2" android:textSize="13sp"/>

        <!-- Ayarlar -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/interval" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#202124" android:layout_marginTop="20dp"/>
        <EditText android:id="@+id/intervalInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLength="7"
            android:hint="100"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/repeat" android:textSize="15sp" android:textStyle="bold"
            android:textColor="#202124" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/repeatInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLength="7"
            android:hint="0"/>

        <Button android:id="@+id/startBtn" android:layout_width="match_parent"
            android:layout_height="56dp" android:layout_marginTop="24dp"
            android:background="@drawable/bg_button" android:textColor="#FFFFFF"
            android:textSize="17sp" android:textStyle="bold" android:textAllCaps="false"
            android:text="@string/show_panel"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_card" android:padding="16dp"
            android:text="@string/help" android:textColor="@color/text2" android:textSize="14sp"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
